  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"next dev -p 3000\" \"node server/index.js\" \"wait-on http://localhost:3000 http://localhost:5000/api/health && electron electron/main.js\"",
    "next": "next dev",
    "server": "node server/index.js",
